# =============================================================================
# 부동산 개인비서 MVP - 환경변수 템플릿
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# =============================================================================

# PostgreSQL 접속 URL
DATABASE_URL=postgresql+asyncpg://mcp_user:password@localhost:5432/real_estate

# OpenAI API 키 (GPT-4o-mini)
OPENAI_API_KEY=

# 카카오 챗봇 설정 (OBT 승인 후 입력)
KAKAO_BOT_ID=
KAKAO_SKILL_SECRET=

# =============================================================================
# 운영 환경 설정
# =============================================================================

# 실행 환경 (development | staging | production)
# production에서는 OPENAI_API_KEY 필수, CORS "*" 금지
ENVIRONMENT=development

# 로그 레벨 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Properties API 인증용 키 (비어있으면 인증 없이 동작 — 개발 모드)
API_KEY=

# CORS 허용 오리진 (콤마 구분, production에서는 명시적 도메인 필수)
# 예: https://admin.example.com,https://app.example.com
CORS_ORIGINS=*
