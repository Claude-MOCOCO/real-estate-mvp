# =============================================================================
# 부동산 매물 관리 시스템 - 환경변수 템플릿
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# =============================================================================

# Discord 봇 토큰
DISCORD_BOT_TOKEN=

# Anthropic Claude API 키
ANTHROPIC_API_KEY=

# PostgreSQL 접속 URL
DATABASE_URL=postgresql://mcp_user:password@localhost:5432/real_estate

# MCP 서버 스크립트 경로
MCP_SERVER_PATH=./mcp_server/server.py

# Claude 모델 (기본값: claude-sonnet-4-5-20250929)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# 채널별 대화 이력 보관 수
MAX_CONVERSATION_HISTORY=10

# 사용자당 분당 요청 제한
RATE_LIMIT_PER_MINUTE=10
